# Copy the keys from your provider dashboards into this file, save, and run.
# This file is local-only: add it to .gitignore / never commit it.

# ---- Trial: Groq (free) --------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-groq-key-here
LLM_MODEL=openai/gpt-oss-120b

# ---- Verifier (falls back to LLM_* above if left blank) ------------------
# VERIFIER_BASE_URL=
# VERIFIER_API_KEY=
# VERIFIER_MODEL=openai/gpt-oss-120b

# ---- Optional tuning ------------------------------------------------------
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=3
# LLM_AUDIT_LOG=llm_audit.jsonl
# VERIFIER_AUDIT_LOG=verifier_audit.jsonl
